{
        "name": "suyu-site",
        "version": "0.0.1",
        "private": true,
        "scripts": {
                "dev": "vite dev",
                "build": "svelte-kit sync && vite build --mode production",
                "preview": "vite preview",
                "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
                "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
                "lint": "prettier --check .",
                "format": "prettier --write ."
        },
        "devDependencies": {
                "@sveltejs/adapter-auto": "^3.0.0",
                "@sveltejs/kit": "^2.57.1",
                "@sveltejs/vite-plugin-svelte": "^3.0.0",
                "@tailwindcss/typography": "^0.5.10",
                "autoprefixer": "^10.4.16",
                "flowbite-svelte-icons": "1",
                "postcss": "^8.4.32",
                "postcss-load-config": "^5.0.2",
                "prettier": "^3.1.1",
                "prettier-plugin-svelte": "^3.1.2",
                "prettier-plugin-tailwindcss": "^0.5.9",
                "svelte": "^5.55.7",
                "svelte-check": "^3.6.0",
                "tailwindcss": "^3.3.6",
                "tslib": "^2.4.1",
                "typescript": "^5.0.0",
                "vite": "^6.4.2",
                "vite-imagetools": "^6.2.9",
                "vite-plugin-image-optimizer": "^1.1.7",
                "vite-plugin-webp-generator": "^0.0.5"
        },
        "type": "module",
        "dependencies": {
                "@icons-pack/svelte-simple-icons": "^5.0.0",
                "@sveltejs/adapter-static": "^3.0.8",
                "@sveltejs/enhanced-img": "^0.8.1",
                "svelte-heros-v2": "^1.3.0"
        },
        "overrides": {
                "braces@<3.0.3": ">=3.0.3",
                "cookie@<0.7.0": ">=0.7.0",
                "cross-spawn@<6.0.6": ">=6.0.6",
                "devalue@>=5.6.3 <=5.8.0": ">=5.8.1",
                "got@<11.8.5": ">=11.8.5",
                "http-cache-semantics@<4.1.1": ">=4.1.1",
                "micromatch@<4.0.8": ">=4.0.8",
                "semver-regex@<3.1.3": ">=3.1.3",
                "semver-regex@<3.1.4": ">=3.1.4"
        }
}
